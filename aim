local function createValueTuner(text, min, max, step, configKey, callback)
    local frame = Instance.new("Frame", Scroll); frame.Size = UDim2.new(0.9, 0, 0, 60); frame.BackgroundTransparency = 1; frame.LayoutOrder = layoutOrder; layoutOrder += 1
    local label = Instance.new("TextLabel", frame); label.Size = UDim2.new(1, 0, 0, 25); label.BackgroundTransparency = 1; label.TextColor3 = Color3.new(1, 1, 1); label.Text = text .. ": " .. Config[configKey]; label.Font = Enum.Font.Gotham
    local btnMinus = Instance.new("TextButton", frame); btnMinus.Size = UDim2.new(0.25, 0, 0, 30); btnMinus.Position = UDim2.new(0, 0, 0, 30); btnMinus.Text = "-"; btnMinus.BackgroundColor3 = Color3.fromRGB(70,70,80); btnMinus.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", btnMinus).CornerRadius = UDim.new(0,5)
    local btnPlus = Instance.new("TextButton", frame); btnPlus.Size = UDim2.new(0.25, 0, 0, 30); btnPlus.Position = UDim2.new(0.75, 0, 0, 30); btnPlus.Text = "+"; btnPlus.BackgroundColor3 = Color3.fromRGB(70,70,80); btnPlus.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", btnPlus).CornerRadius = UDim.new(0,5)
    btnMinus.MouseButton1Click:Connect(function() Config[configKey] = math.max(min, Config[configKey] - step); label.Text = text .. ": " .. Config[configKey]; if callback then callback() end end)
    btnPlus.MouseButton1Click:Connect(function() Config[configKey] = math.min(max, Config[configKey] + step); label.Text = text .. ": " .. Config[configKey]; if callback then callback() end end)
end

