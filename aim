-- ==================== LOGIC ĐỊCH/TA & ESP ====================
local function IsEnemy(targetPlayer)
    if targetPlayer == LocalPlayer then return false end
    if not Config.TeamCheck then return true end 
    if LocalPlayer.Team == nil or targetPlayer.Team == nil then return true end
    return LocalPlayer.Team ~= targetPlayer.Team
end

local function refreshESP()
    for player, highlight in pairs(activeHighlights) do
        if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and highlight.Parent then
            if Config.ESP then
                if IsEnemy(player) then
                    highlight.Enabled = true
                    highlight.FillColor = Config.EnemyColor
                else
                    highlight.Enabled = Config.ShowTeammates
                    highlight.FillColor = Config.TeamColor
                end
            else
                highlight.Enabled = false
            end
        else
            if highlight then highlight:Destroy() end
            activeHighlights[player] = nil
        end
    end
end

local function applyESP(player, character)
    if not character then return end
    -- Đợi nhân vật thực sự load xong (Fix lỗi ESP không hiện)
    local hrp = character:WaitForChild("HumanoidRootPart", 3)
    if not hrp then return end

    if activeHighlights[player] then activeHighlights[player]:Destroy() end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "TestingESP"
    highlight.Adornee = character -- Bắt buộc gán Adornee
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.OutlineTransparency = 0.2
    highlight.Parent = CoreGui -- Parent vào CoreGui để an toàn, Adornee gắn vào char
    activeHighlights[player] = highlight
    
    refreshESP()
end

local function setupPlayer(player)
    if player == LocalPlayer then return end
    table.insert(connections, player:GetPropertyChangedSignal("Team"):Connect(refreshESP))
    table.insert(connections, player.CharacterAdded:Connect(function(char)
        applyESP(player, char)
    end))
    if player.Character then applyESP(player, player.Character) end
end

table.insert(connections, LocalPlayer:GetPropertyChangedSignal("Team"):Connect(refreshESP))
for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end
table.insert(connections, Players.PlayerAdded:Connect(setupPlayer))
table.insert(connections, Players.PlayerRemoving:Connect(function(player)
