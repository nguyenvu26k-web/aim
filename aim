end

local function setupPlayer(player)
    if player == LocalPlayer then return end
    table.insert(connections, player:GetPropertyChangedSignal("Team"):Connect(refreshESP))
    table.insert(connections, player.CharacterAdded:Connect(function(char) applyESP(player, char) end))
    if player.Character then applyESP(player, player.Character) end
end

