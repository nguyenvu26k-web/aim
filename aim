local function createButton(text, stateVar, callback)
    local btn = Instance.new("TextButton", Scroll); btn.Size = UDim2.new(0.9, 0, 0, 35); btn.BackgroundColor3 = Config[stateVar] and Color3.fromRGB(50, 150, 80) or Color3.fromRGB(60, 60, 70); btn.TextColor3 = Color3.new(1, 1, 1); btn.Text = text .. ": " .. (Config[stateVar] and "ON" or "OFF"); btn.Font = Enum.Font.GothamBold; btn.LayoutOrder = layoutOrder; layoutOrder += 1; Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
