-- ==================== LOGIC FPS OPTIMIZER ====================
local function optimizeInstance(inst, modeSettings)
    if not inst or not inst.Parent then return end
    if inst:IsA("BasePart") then
        if modeSettings.SmoothPlastic then
            if not GraphicsCache.Parts[inst] then GraphicsCache.Parts[inst] = { Material = inst.Material, CastShadow = inst.CastShadow } end
            pcall(function() inst.Material = Enum.Material.SmoothPlastic; inst.CastShadow = false end)
        elseif not modeSettings.CastShadow then
            if not GraphicsCache.Parts[inst] then GraphicsCache.Parts[inst] = { CastShadow = inst.CastShadow } end
            pcall(function() inst.CastShadow = false end)
        end
    elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
        local shouldDisable = (not modeSettings.Particles) or (modeSettings.Particles and (inst:IsA("Smoke") or inst:IsA("Fire")))
        if shouldDisable then
            if GraphicsCache.Particles[inst] == nil then GraphicsCache.Particles[inst] = inst.Enabled end
            pcall(function() inst.Enabled = false end)
        end
    elseif inst:IsA("Decal") or inst:IsA("Texture") then
        if modeSettings.HideDecals then
            if GraphicsCache.Decals[inst] == nil then GraphicsCache.Decals[inst] = inst.Transparency end
            pcall(function() inst.Transparency = 1 end) 
        end
    end
end

local function applyOptimization()
    local settings = OptModes[Config.GraphicsMode]
    GraphicsCache.Lighting.GlobalShadows = Lighting.GlobalShadows
    pcall(function() Lighting.GlobalShadows = settings.Shadows end)
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("PostEffect") or effect:IsA("BlurEffect") or effect:IsA("BloomEffect") or effect:IsA("SunRaysEffect") or effect:IsA("ColorCorrectionEffect") or effect:IsA("DepthOfFieldEffect") then
            if GraphicsCache.Lighting[effect] == nil then GraphicsCache.Lighting[effect] = effect.Enabled end
            pcall(function() effect.Enabled = settings.PostProcessing end)
        end
    end
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        GraphicsCache.Terrain = { WaveSize = terrain.WaterWaveSize, WaveSpeed = terrain.WaterWaveSpeed, Reflectance = terrain.WaterReflectance }
        pcall(function() terrain.WaterWaveSize = 0; terrain.WaterWaveSpeed = 0; terrain.WaterReflectance = 0 end)
    end
    task.spawn(function()
        local count = 0
        for _, inst in ipairs(Workspace:GetDescendants()) do
            optimizeInstance(inst, settings)
            count = count + 1; if count % 5000 == 0 then task.wait() end 
        end
    end)
    if graphicsAddedConn then graphicsAddedConn:Disconnect() end
    graphicsAddedConn = Workspace.DescendantAdded:Connect(function(newChild)
        if Config.GraphicsOptimized then optimizeInstance(newChild, OptModes[Config.GraphicsMode]) end
    end)
end

local function restoreGraphics()
    if graphicsAddedConn then graphicsAddedConn:Disconnect(); graphicsAddedConn = nil end
    pcall(function() Lighting.GlobalShadows = GraphicsCache.Lighting.GlobalShadows end)
    for effect, state in pairs(GraphicsCache.Lighting) do
        if typeof(effect) == "Instance" and effect.Parent then pcall(function() effect.Enabled = state end) end
    end
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain and GraphicsCache.Terrain.WaveSize then
        pcall(function() terrain.WaterWaveSize = GraphicsCache.Terrain.WaveSize; terrain.WaterWaveSpeed = GraphicsCache.Terrain.WaveSpeed; terrain.WaterReflectance = GraphicsCache.Terrain.Reflectance end)
    end
    for part, data in pairs(GraphicsCache.Parts) do
        if part and part.Parent then pcall(function() if data.Material then part.Material = data.Material end; if data.CastShadow ~= nil then part.CastShadow = data.CastShadow end end) end
    end
    for inst, state in pairs(GraphicsCache.Particles) do if inst and inst.Parent then pcall(function() inst.Enabled = state end) end end
    for inst, state in pairs(GraphicsCache.Decals) do if inst and inst.Parent then pcall(function() inst.Transparency = state end) end end
    GraphicsCache = { Lighting = {}, Terrain = {}, Parts = {}, Particles = {}, Decals = {} }
end

-- ==================== LOGIC ĐỊCH/TA & ESP ====================
local function IsEnemy(targetPlayer)
    if targetPlayer == LocalPlayer then return false end
    if not Config.TeamCheck then return true end 
    if LocalPlayer.Team == nil or targetPlayer.Team == nil then return true end
    return LocalPlayer.Team ~= targetPlayer.Team
end

local function getPlayerNameText(player)
    if Config.NameMode == "DisplayName" then return player.DisplayName end
    if Config.NameMode == "Username" then return "@" .. player.Name end
    return player.DisplayName .. " (@" .. player.Name .. ")"
end

local function refreshESP()
    for player, highlight in pairs(activeHighlights) do
        local tag = activeNameTags[player]
        if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and highlight.Parent then
            local isEnm = IsEnemy(player)
            local isVisible = isEnm or Config.ShowTeammates
            local color = isEnm and Config.EnemyColor or Config.TeamColor
            
            if Config.ESP and isVisible then highlight.Enabled = true; highlight.FillColor = color else highlight.Enabled = false end
            if tag then
                if Config.NameESP and isVisible then
                    tag.Enabled = true; tag.MaxDistance = Config.NameMaxDistance; tag.TextLabel.TextColor3 = color
                    if not Config.ShowDistance then tag.TextLabel.Text = getPlayerNameText(player) end
                else tag.Enabled = false end
            end
        else
            if highlight then highlight:Destroy() end; if tag then tag:Destroy() end
            activeHighlights[player] = nil; activeNameTags[player] = nil
        end
    end
end

local function applyESP(player, character)
    if not character then return end
    local hrp = character:WaitForChild("HumanoidRootPart", 3)
    local head = character:WaitForChild("Head", 3) or hrp
    if not hrp then return end

    if activeHighlights[player] then activeHighlights[player]:Destroy() end
    if activeNameTags[player] then activeNameTags[player]:Destroy() end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "TestingESP"; highlight.Adornee = character; highlight.OutlineColor = Color3.new(1, 1, 1); highlight.OutlineTransparency = 0.2
    
    -- Gắn an toàn vào CoreGui hoặc PlayerGui
