-- ==================== THUẬT TOÁN NGẮM ====================
local function getClosestTarget()
    local nearestDist = Config.FOVRadius
    local bestTarget = nil
    local screenCenter = Camera.ViewportSize / 2 
    local debugReason = "Không tìm thấy mục tiêu"

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local hum, hrp, targetPart = char:FindFirstChild("Humanoid"), char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild(Config.TargetPart)
        
        if not (hum and hrp and targetPart) then continue end
        if hum.Health <= 0 then continue end
        if not IsEnemy(player) then debugReason = "Mục tiêu là Đồng Đội"; continue end
        
        local dist3D = (targetPart.Position - Camera.CFrame.Position).Magnitude
        if dist3D > Config.MaxDistance then debugReason = "Ngoài tầm Max Distance"; continue end
        
        local vector, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then debugReason = "Khuất sau Camera"; continue end
        
        local dist2D = (Vector2.new(vector.X, vector.Y) - screenCenter).Magnitude
        if dist2D > nearestDist then debugReason = "Ngoài vòng FOV"; continue end
        
        if Config.VisibilityCheck then
            local rayParams = RaycastParams.new(); rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}; rayParams.FilterType = Enum.RaycastFilterType.Exclude
            local result = workspace:Raycast(Camera.CFrame.Position, (targetPart.Position - Camera.CFrame.Position).Unit * dist3D, rayParams)
            if result and result.Instance and not result.Instance:IsDescendantOf(char) then debugReason = "Vật cản: " .. result.Instance.Name; continue end
        end
        nearestDist = dist2D; bestTarget = targetPart; debugReason = "Đã khóa: " .. player.Name
    end
    Config.DebugText = debugReason
    return bestTarget
end

