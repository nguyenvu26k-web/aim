-- HÀM TẠO NÚT NHÉT VÀO SCROLLING FRAME
local layoutOrder = 0
local function createButton(text, initialState, callback)
    local btn = Instance.new("TextButton", Scroll)
    btn.Size = UDim2.new(0.9, 0, 0, 35) -- Tăng size cho dễ bấm chạm
    btn.BackgroundColor3 = initialState and Color3.fromRGB(50, 150, 80) or Color3.fromRGB(60, 60, 70)
    btn.TextColor3 = Color3.new(1, 1, 1); btn.Text = text .. ": " .. (initialState and "ON" or "OFF"); btn.Font = Enum.Font.GothamBold
    btn.LayoutOrder = layoutOrder; layoutOrder += 1
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    
    local state = initialState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(50, 150, 80) or Color3.fromRGB(60, 60, 70)
        btn.Text = text .. ": " .. (state and "ON" or "OFF")
        callback(state)
    end)
    return btn
end

local function createValueTuner(text, min, max, step, configKey)
    local frame = Instance.new("Frame", Scroll)
    frame.Size = UDim2.new(0.9, 0, 0, 60)
    frame.BackgroundTransparency = 1
    frame.LayoutOrder = layoutOrder; layoutOrder += 1

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, 0, 0, 25)
    label.BackgroundTransparency = 1; label.TextColor3 = Color3.new(1, 1, 1); label.Text = text .. ": " .. Config[configKey]; label.Font = Enum.Font.Gotham
    
    local btnMinus = Instance.new("TextButton", frame); btnMinus.Size = UDim2.new(0.25, 0, 0, 30); btnMinus.Position = UDim2.new(0, 0, 0, 30); btnMinus.Text = "-"; btnMinus.BackgroundColor3 = Color3.fromRGB(70,70,80); btnMinus.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", btnMinus).CornerRadius = UDim.new(0,5)
    local btnPlus = Instance.new("TextButton", frame); btnPlus.Size = UDim2.new(0.25, 0, 0, 30); btnPlus.Position = UDim2.new(0.75, 0, 0, 30); btnPlus.Text = "+"; btnPlus.BackgroundColor3 = Color3.fromRGB(70,70,80); btnPlus.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", btnPlus).CornerRadius = UDim.new(0,5)
    
    btnMinus.MouseButton1Click:Connect(function() Config[configKey] = math.max(min, Config[configKey] - step); label.Text = text .. ": " .. Config[configKey] end)
    btnPlus.MouseButton1Click:Connect(function() Config[configKey] = math.min(max, Config[configKey] + step); label.Text = text .. ": " .. Config[configKey] end)
end

